{
  "name": "my-mba-room-hostel-expense-tracker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "test:security": "node scripts/test-deepmerge-security.cjs",
    "test:accounting": "node --test scripts/accounting.test.mjs",
    "test:rules": "node --test scripts/firestore-rules.test.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "deepmerge": "file:vendor/deepmerge",
    "@firebase/rules-unit-testing": "4.0.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.7",
    "glob": "12.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true
  }
}
