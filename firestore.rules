rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomPath(roomId) { return /databases/$(database)/documents/rooms/$(roomId); }
    function memberPath(roomId, userId) { return /databases/$(database)/documents/rooms/$(roomId)/members/$(userId); }
    function invitePath(code) { return /databases/$(database)/documents/inviteCodes/$(code); }
    function closingPath(roomId, monthKey) { return /databases/$(database)/documents/rooms/$(roomId)/closings/$(monthKey); }
    function isRoomMember(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid))
        && get(memberPath(roomId, request.auth.uid)).data.is_active == true;
    }
    function isRoomAdmin(roomId) {
      return isRoomMember(roomId) && get(memberPath(roomId, request.auth.uid)).data.role == 'admin';
    }
    function validMonthKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-01$');
    }
    function validDateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validMoney(value) {
      return value is number && value >= 0.01 && value <= 10000000
        && ((value * 100) % 1) == 0;
    }
    function monthIsOpen(roomId, monthKey) {
      let path = closingPath(roomId, monthKey);
      return validMonthKey(monthKey) && (!exists(path) || get(path).data.reopened_at != null);
    }
    function inviteAllows(code, roomId) {
      return code is string && code.size() >= 4
        && exists(invitePath(code))
        && get(invitePath(code)).data.room_id == roomId
        && get(invitePath(code)).data.active == true;
    }

    // Firestore rules cannot reduce an arbitrary list; validate every possible
    // share entry up to the deliberately bounded six-person meal group.
    function validShareAt(roomId, shares, index) {
      return shares.size() <= index || (
        shares[index] is map
        && shares[index].keys().hasAll(['user_id', 'amount'])
        && shares[index].keys().hasOnly(['user_id', 'amount'])
        && shares[index].user_id is string
        && shares[index].user_id.size() > 0
        && validMoney(shares[index].amount)
        && get(memberPath(roomId, shares[index].user_id)).data.is_active == true
      );
    }
    function sharesHaveUniqueIds(shares) {
      return (shares.size() < 2 || shares[0].user_id != shares[1].user_id)
        && (shares.size() < 3 || (shares[0].user_id != shares[2].user_id && shares[1].user_id != shares[2].user_id))
        && (shares.size() < 4 || (shares[0].user_id != shares[3].user_id && shares[1].user_id != shares[3].user_id && shares[2].user_id != shares[3].user_id))
        && (shares.size() < 5 || (shares[0].user_id != shares[4].user_id && shares[1].user_id != shares[4].user_id && shares[2].user_id != shares[4].user_id && shares[3].user_id != shares[4].user_id))
        && (shares.size() < 6 || (shares[0].user_id != shares[5].user_id && shares[1].user_id != shares[5].user_id && shares[2].user_id != shares[5].user_id && shares[3].user_id != shares[5].user_id && shares[4].user_id != shares[5].user_id));
    }
    function sumShareAmounts(shares) {
      return shares[0].amount
        + (shares.size() > 1 ? shares[1].amount : 0)
        + (shares.size() > 2 ? shares[2].amount : 0)
        + (shares.size() > 3 ? shares[3].amount : 0)
        + (shares.size() > 4 ? shares[4].amount : 0)
        + (shares.size() > 5 ? shares[5].amount : 0);
    }
    function validShareList(roomId, shares, total) {
      return shares is list && shares.size() > 0 && shares.size() <= 6
        && validShareAt(roomId, shares, 0)
        && validShareAt(roomId, shares, 1)
        && validShareAt(roomId, shares, 2)
        && validShareAt(roomId, shares, 3)
        && validShareAt(roomId, shares, 4)
        && validShareAt(roomId, shares, 5)
        && sharesHaveUniqueIds(shares)
        && sumShareAmounts(shares) > total - 0.001
        && sumShareAmounts(shares) < total + 0.001;
    }
    function validRoomData(data) {
      return data.keys().hasAll(['name', 'join_code', 'admin_user_id', 'currency_code', 'track_reimbursements', 'default_split_method', 'created_at'])
        && data.keys().hasOnly(['name', 'join_code', 'admin_user_id', 'currency_code', 'track_reimbursements', 'default_split_method', 'created_at'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.join_code is string && data.join_code.size() >= 4 && data.join_code.size() <= 32
        && data.admin_user_id is string
        && data.currency_code is string && data.currency_code.size() == 3
        && data.track_reimbursements is bool
        && data.default_split_method in ['equal', 'custom']
        && data.created_at is string;
    }
    function validExpenseData(roomId, expenseId, data) {
      return data.keys().hasAll(['id', 'room_id', 'created_by', 'description', 'total_amount', 'meal_date', 'month_key', 'entry_mode', 'is_deleted', 'created_at', 'updated_at', 'shares'])
        && data.keys().hasOnly(['id', 'room_id', 'created_by', 'description', 'total_amount', 'meal_date', 'month_key', 'entry_mode', 'is_deleted', 'created_at', 'updated_at', 'shares'])
        && data.id == expenseId
        && data.room_id == roomId
        && data.created_by is string
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200
        && validMoney(data.total_amount)
        && validDateString(data.meal_date)
        && validMonthKey(data.month_key)
        && data.entry_mode in ['shared', 'individual', 'custom']
        && data.is_deleted is bool
        && data.created_at is string && data.updated_at is string
        && validShareList(roomId, data.shares, data.total_amount);
    }
    function validPaymentData(roomId, paymentId, data) {
      return data.keys().hasAll(['id', 'room_id', 'amount', 'paid_by', 'recorded_by', 'payment_date', 'month_key', 'note', 'is_deleted', 'created_at', 'updated_at'])
        && data.keys().hasOnly(['id', 'room_id', 'amount', 'paid_by', 'recorded_by', 'payment_date', 'month_key', 'note', 'is_deleted', 'created_at', 'updated_at'])
        && data.id == paymentId
        && data.room_id == roomId
        && validMoney(data.amount)
        && data.paid_by is string
        && get(memberPath(roomId, data.paid_by)).data.is_active == true
        && data.recorded_by is string
        && validDateString(data.payment_date)
        && validMonthKey(data.month_key)
        && data.note is string && data.note.size() <= 500
        && data.is_deleted is bool
        && data.created_at is string && data.updated_at is string;
    }
    function validReimbursementData(roomId, reimbursementId, data) {
      return data.keys().hasAll(['id', 'room_id', 'from_member', 'to_member', 'amount', 'payment_date', 'note', 'recorded_by', 'is_deleted', 'created_at'])
        && data.keys().hasOnly(['id', 'room_id', 'from_member', 'to_member', 'amount', 'payment_date', 'note', 'recorded_by', 'is_deleted', 'created_at'])
        && data.id == reimbursementId
        && data.room_id == roomId
        && data.from_member is string && data.to_member is string
        && data.from_member != data.to_member
        && get(memberPath(roomId, data.from_member)).data.is_active == true
        && get(memberPath(roomId, data.to_member)).data.is_active == true
        && validMoney(data.amount)
        && validDateString(data.payment_date)
        && data.note is string && data.note.size() <= 500
        && data.recorded_by == request.auth.uid
        && data.is_deleted is bool
        && data.created_at is string;
    }
    function validClosingSnapshot(snapshot) {
      return snapshot is map
        && snapshot.keys().hasAll(['expense_total', 'payment_total', 'monthly_net', 'remaining'])
        && snapshot.keys().hasOnly(['expense_total', 'payment_total', 'monthly_net', 'remaining'])
        && snapshot.expense_total is number
        && snapshot.payment_total is number
        && snapshot.monthly_net is number
        && snapshot.remaining is number
        && snapshot.monthly_net > (snapshot.expense_total - snapshot.payment_total) - 0.001
        && snapshot.monthly_net < (snapshot.expense_total - snapshot.payment_total) + 0.001;
    }

    function activityBase(roomId) {
      return signedIn()
        && request.resource.data.keys().hasAll(['room_id', 'actor_id', 'action', 'entity_type', 'entity_id', 'before_data', 'after_data', 'detail', 'created_at'])
        && request.resource.data.keys().hasOnly(['room_id', 'actor_id', 'action', 'entity_type', 'entity_id', 'before_data', 'after_data', 'detail', 'created_at'])
        && request.resource.data.room_id == roomId
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.action in [
          'room.created', 'room.member_joined', 'room.invite_code_regenerated',
          'room.reimbursements_setting_changed', 'room.member_removed', 'profile.name_changed',
          'expense.created', 'expense.updated', 'expense.deleted',
          'payment.recorded', 'payment.updated', 'payment.deleted',
          'reimbursement.recorded', 'month.closed', 'month.reopened'
        ]
        && request.resource.data.entity_type is string
        && request.resource.data.entity_id is string
        && request.resource.data.entity_id.size() > 0
        && request.resource.data.detail is string
        && request.resource.data.created_at is string;
    }
    function expenseActivityMatches(roomId) {
      let expenseId = request.resource.data.entity_id;
      let path = /databases/$(database)/documents/rooms/$(roomId)/expenses/$(expenseId);
      let action = request.resource.data.action;
      return request.resource.data.entity_type == 'expense'
        && action in ['expense.created', 'expense.updated', 'expense.deleted']
        && existsAfter(path)
        && request.resource.data.after_data == getAfter(path).data
        && getAfter(path).data.room_id == roomId
        && (
          (action == 'expense.created' && !exists(path) && getAfter(path).data.created_by == request.auth.uid)
          || (action == 'expense.updated' && exists(path)
            && (get(path).data.created_by == request.auth.uid || isRoomAdmin(roomId))
            && get(path).data.is_deleted != true && getAfter(path).data.is_deleted == false
            && getAfter(path).data.diff(get(path).data).affectedKeys().size() > 0)
          || (action == 'expense.deleted' && exists(path)
            && (get(path).data.created_by == request.auth.uid || isRoomAdmin(roomId))
            && get(path).data.is_deleted != true && getAfter(path).data.is_deleted == true
            && getAfter(path).data.diff(get(path).data).affectedKeys().size() > 0)
        );
    }
    function paymentActivityMatches(roomId) {
      let paymentId = request.resource.data.entity_id;
      let path = /databases/$(database)/documents/rooms/$(roomId)/payments/$(paymentId);
      let action = request.resource.data.action;
      return request.resource.data.entity_type == 'canteen_payment'
        && action in ['payment.recorded', 'payment.updated', 'payment.deleted']
        && existsAfter(path)
        && request.resource.data.after_data == getAfter(path).data
        && getAfter(path).data.room_id == roomId
        && (
          (action == 'payment.recorded' && !exists(path) && getAfter(path).data.recorded_by == request.auth.uid)
          || (action == 'payment.updated' && exists(path)
            && (get(path).data.recorded_by == request.auth.uid || isRoomAdmin(roomId))
            && get(path).data.is_deleted != true && getAfter(path).data.is_deleted == false
            && getAfter(path).data.diff(get(path).data).affectedKeys().size() > 0)
          || (action == 'payment.deleted' && exists(path)
            && (get(path).data.recorded_by == request.auth.uid || isRoomAdmin(roomId))
            && get(path).data.is_deleted != true && getAfter(path).data.is_deleted == true
            && getAfter(path).data.diff(get(path).data).affectedKeys().size() > 0)
        );
    }
    function reimbursementActivityMatches(roomId) {
      let reimbursementId = request.resource.data.entity_id;
      let path = /databases/$(database)/documents/rooms/$(roomId)/reimbursements/$(reimbursementId);
      return request.resource.data.action == 'reimbursement.recorded'
        && request.resource.data.entity_type == 'roommate_reimbursement'
        && !exists(path) && existsAfter(path)
        && request.resource.data.after_data == getAfter(path).data
        && getAfter(path).data.recorded_by == request.auth.uid
        && getAfter(path).data.room_id == roomId;
    }
    function roomCreatedActivityMatches(roomId) {
      let path = roomPath(roomId);
      let admin = memberPath(roomId, request.auth.uid);
      return request.resource.data.action == 'room.created'
        && request.resource.data.entity_type == 'room'
        && request.resource.data.entity_id == roomId
        && request.resource.data.after_data is map
        && !exists(path) && existsAfter(path)
        && getAfter(path).data.admin_user_id == request.auth.uid
        && getAfter(path).data.name == request.resource.data.after_data.name
        && getAfter(admin).data.role == 'admin' && getAfter(admin).data.is_active == true;
    }
    function memberJoinedActivityMatches(roomId) {
      let memberId = request.resource.data.entity_id;
      let path = memberPath(roomId, memberId);
      return request.resource.data.action == 'room.member_joined'
        && request.resource.data.entity_type == 'room_member'
        && request.resource.data.after_data is map
        && (!exists(path) || get(path).data.is_active == false)
        && existsAfter(path)
        && getAfter(path).data.user_id == memberId
        && getAfter(path).data.role == 'member'
        && getAfter(path).data.is_active == true
        && getAfter(path).data.display_name == request.resource.data.after_data.display_name
        && inviteAllows(getAfter(path).data.join_code, roomId);
    }
    function inviteRegeneratedActivityMatches(roomId) {
      let room = roomPath(roomId);
      return request.resource.data.action == 'room.invite_code_regenerated'
        && request.resource.data.entity_type == 'room'
        && request.resource.data.entity_id == roomId
        && request.resource.data.before_data is string
        && request.resource.data.after_data is string
        && request.resource.data.before_data != request.resource.data.after_data
        && isRoomAdmin(roomId)
        && getAfter(room).data.join_code == request.resource.data.after_data
        && existsAfter(invitePath(request.resource.data.after_data))
        && getAfter(invitePath(request.resource.data.after_data)).data.room_id == roomId
        && getAfter(invitePath(request.resource.data.after_data)).data.active == true
        && exists(invitePath(request.resource.data.before_data))
        && getAfter(invitePath(request.resource.data.before_data)).data.active == false;
    }
    function reimbursementSettingActivityMatches(roomId) {
      let path = roomPath(roomId);
      return request.resource.data.action == 'room.reimbursements_setting_changed'
        && request.resource.data.entity_type == 'room'
        && request.resource.data.entity_id == roomId
        && request.resource.data.after_data is bool
        && isRoomAdmin(roomId)
        && get(path).data.track_reimbursements != request.resource.data.after_data
        && getAfter(path).data.track_reimbursements == request.resource.data.after_data;
    }
    function memberRemovedActivityMatches(roomId) {
      let memberId = request.resource.data.entity_id;
      let path = memberPath(roomId, memberId);
      return request.resource.data.action == 'room.member_removed'
        && request.resource.data.entity_type == 'room_member'
        && request.resource.data.after_data is map
        && isRoomAdmin(roomId)
        && get(path).data.is_active == true
        && getAfter(path).data.is_active == false
        && request.resource.data.after_data.is_active == false
        && request.resource.data.after_data.left_at == getAfter(path).data.left_at;
    }
    function profileNameActivityMatches(roomId) {
      let path = memberPath(roomId, request.auth.uid);
      return request.resource.data.action == 'profile.name_changed'
        && request.resource.data.entity_type == 'room_member'
        && request.resource.data.entity_id == request.auth.uid
        && request.resource.data.after_data is string
        && request.resource.data.after_data.size() >= 1
        && isRoomMember(roomId)
        && get(path).data.display_name != request.resource.data.after_data
        && getAfter(path).data.display_name == request.resource.data.after_data;
    }
    function closingActivityMatches(roomId) {
      let monthKey = request.resource.data.entity_id;
      let path = closingPath(roomId, monthKey);
      let action = request.resource.data.action;
      return request.resource.data.entity_type == 'monthly_closing'
        && validMonthKey(monthKey) && isRoomAdmin(roomId)
        && (
          (action == 'month.closed' && !exists(path) && existsAfter(path)
            && getAfter(path).data.room_id == roomId
            && getAfter(path).data.month_start == monthKey
            && getAfter(path).data.closed_by == request.auth.uid
            && getAfter(path).data.reopened_at == null
            && request.resource.data.after_data == getAfter(path).data.snapshot)
          || (action == 'month.reopened' && exists(path)
            && get(path).data.reopened_at == null
            && getAfter(path).data.reopened_at is string
            && getAfter(path).data.reopened_by == request.auth.uid
            && request.resource.data.after_data is map
            && request.resource.data.after_data.reopened_at == getAfter(path).data.reopened_at
            && request.resource.data.after_data.reason == getAfter(path).data.reopen_reason)
        );
    }
    function validActivityAction(roomId) {
      return expenseActivityMatches(roomId)
        || paymentActivityMatches(roomId)
        || reimbursementActivityMatches(roomId)
        || roomCreatedActivityMatches(roomId)
        || memberJoinedActivityMatches(roomId)
        || inviteRegeneratedActivityMatches(roomId)
        || reimbursementSettingActivityMatches(roomId)
        || memberRemovedActivityMatches(roomId)
        || profileNameActivityMatches(roomId)
        || closingActivityMatches(roomId);
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
      match /rooms/{roomId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
          && getAfter(memberPath(roomId, userId)).data.is_active == true;
        allow update: if signedIn() && (
          request.auth.uid == userId
          || (isRoomAdmin(roomId) && request.resource.data.is_active == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_active', 'left_at']))
        );
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['room_id', 'active', 'created_by', 'created_at'])
        && request.resource.data.keys().hasOnly(['room_id', 'active', 'created_by', 'created_at'])
        && request.resource.data.active == true
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.room_id is string
        && getAfter(roomPath(request.resource.data.room_id)).data.admin_user_id == request.auth.uid;
      allow update: if signedIn() && isRoomAdmin(resource.data.room_id)
        && request.resource.data.room_id == resource.data.room_id
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'revoked_at'])
        && request.resource.data.active == false
        && request.resource.data.revoked_at is string;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow create: if signedIn() && request.resource.data.admin_user_id == request.auth.uid
        && validRoomData(request.resource.data);
      allow get, list: if isRoomMember(roomId);
      allow update: if isRoomAdmin(roomId)
        && request.resource.data.admin_user_id == resource.data.admin_user_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['join_code', 'track_reimbursements'])
        && request.resource.data.join_code is string
        && request.resource.data.track_reimbursements is bool;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isRoomMember(roomId) || (signedIn() && request.auth.uid == memberId);
        allow create: if signedIn() && request.auth.uid == memberId
          && request.resource.data.keys().hasAll(['user_id', 'display_name', 'email', 'role', 'is_active', 'joined_at'])
          && request.resource.data.keys().hasOnly(['user_id', 'display_name', 'email', 'role', 'is_active', 'joined_at', 'join_code'])
          && request.resource.data.user_id == memberId
          && request.resource.data.display_name is string
          && request.resource.data.display_name.size() >= 1
          && request.resource.data.display_name.size() <= 80
          && request.resource.data.email is string
          && request.resource.data.role in ['admin', 'member']
          && request.resource.data.is_active == true
          && request.resource.data.joined_at is string
          && (
            (request.resource.data.role == 'admin'
              && getAfter(roomPath(roomId)).data.admin_user_id == request.auth.uid)
            || (request.resource.data.role == 'member'
              && inviteAllows(request.resource.data.join_code, roomId))
          );
        allow update: if (
          (signedIn() && request.auth.uid == memberId && isRoomMember(roomId)
            && request.resource.data.user_id == resource.data.user_id
            && request.resource.data.role == resource.data.role
            && request.resource.data.is_active == resource.data.is_active
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name']))
          || (isRoomAdmin(roomId) && memberId != request.auth.uid
            && resource.data.is_active == true
            && request.resource.data.user_id == resource.data.user_id
            && request.resource.data.role == resource.data.role
            && request.resource.data.is_active == false
            && request.resource.data.left_at is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_active', 'left_at']))
          || (signedIn() && request.auth.uid == memberId
            && resource.data.is_active == false
            && request.resource.data.user_id == memberId
            && request.resource.data.role == 'member'
            && request.resource.data.is_active == true
            && request.resource.data.display_name is string
            && request.resource.data.email is string
            && request.resource.data.joined_at is string
            && request.resource.data.join_code is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name', 'email', 'is_active', 'joined_at', 'left_at', 'join_code'])
            && inviteAllows(request.resource.data.join_code, roomId))
        );
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.resource.data.created_by == request.auth.uid
          && validExpenseData(roomId, expenseId, request.resource.data)
          && monthIsOpen(roomId, request.resource.data.month_key);
        allow update: if isRoomMember(roomId)
          && resource.data.is_deleted != true
          && (resource.data.created_by == request.auth.uid || isRoomAdmin(roomId))
          && request.resource.data.room_id == resource.data.room_id
          && request.resource.data.id == resource.data.id
          && request.resource.data.created_by == resource.data.created_by
          && request.resource.data.created_at == resource.data.created_at
          && validExpenseData(roomId, expenseId, request.resource.data)
          && monthIsOpen(roomId, resource.data.month_key)
          && monthIsOpen(roomId, request.resource.data.month_key);
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.resource.data.recorded_by == request.auth.uid
          && validPaymentData(roomId, paymentId, request.resource.data)
          && monthIsOpen(roomId, request.resource.data.month_key);
        allow update: if isRoomMember(roomId)
          && resource.data.is_deleted != true
          && (resource.data.recorded_by == request.auth.uid || isRoomAdmin(roomId))
          && request.resource.data.room_id == resource.data.room_id
          && request.resource.data.id == resource.data.id
          && request.resource.data.recorded_by == resource.data.recorded_by
          && request.resource.data.created_at == resource.data.created_at
          && validPaymentData(roomId, paymentId, request.resource.data)
          && monthIsOpen(roomId, resource.data.month_key)
          && monthIsOpen(roomId, request.resource.data.month_key);
        allow delete: if false;
      }

      match /reimbursements/{reimbursementId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && get(roomPath(roomId)).data.track_reimbursements == true
          && request.resource.data.recorded_by == request.auth.uid
          && validReimbursementData(roomId, reimbursementId, request.resource.data);
        allow update: if isRoomMember(roomId)
          && (resource.data.recorded_by == request.auth.uid || isRoomAdmin(roomId))
          && get(roomPath(roomId)).data.track_reimbursements == true
          && request.resource.data.room_id == resource.data.room_id
          && request.resource.data.id == resource.data.id
          && request.resource.data.recorded_by == resource.data.recorded_by
          && request.resource.data.created_at == resource.data.created_at
          && validReimbursementData(roomId, reimbursementId, request.resource.data);
        allow delete: if false;
      }

      match /activity/{activityId} {
        allow read: if isRoomMember(roomId);
        allow create: if activityBase(roomId) && validActivityAction(roomId);
        allow update, delete: if false;
      }

      match /closings/{monthKey} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomAdmin(roomId)
          && request.resource.data.keys().hasAll(['id', 'room_id', 'month_start', 'closed_by', 'closed_at', 'reopened_at', 'snapshot'])
          && request.resource.data.keys().hasOnly(['id', 'room_id', 'month_start', 'closed_by', 'closed_at', 'reopened_at', 'snapshot'])
          && request.resource.data.id == monthKey
          && request.resource.data.room_id == roomId
          && request.resource.data.closed_by == request.auth.uid
          && request.resource.data.month_start == monthKey
          && validMonthKey(monthKey)
          && request.resource.data.closed_at is string
          && request.resource.data.reopened_at == null
          && validClosingSnapshot(request.resource.data.snapshot);
        allow update: if isRoomAdmin(roomId)
          && resource.data.reopened_at == null
          && request.resource.data.closed_by == resource.data.closed_by
          && request.resource.data.closed_at == resource.data.closed_at
          && request.resource.data.month_start == resource.data.month_start
          && request.resource.data.id == resource.data.id
          && request.resource.data.room_id == resource.data.room_id
          && request.resource.data.reopened_at is string
          && request.resource.data.reopened_by == request.auth.uid
          && request.resource.data.reopen_reason is string
          && request.resource.data.reopen_reason.size() >= 3
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reopened_at', 'reopen_reason', 'reopened_by']);
        allow delete: if false;
      }
    }
  }
}
